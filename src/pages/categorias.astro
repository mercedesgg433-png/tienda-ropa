---
// src/pages/categorias.astro
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tienda de Ropa - Categorías</title>
  </head>
  <body>
    <div class="categories-container">
      <!-- Sección Mujer -->
      <div class="category-card">
        <img src="/mujer.jpg" alt="Sección Mujer" />
        <div class="overlay">
          <h1 class="vertical-text">MUJER</h1>
        </div>
      </div>

      <!-- Sección Hombre -->
      <div class="category-card">
        <img src="/hombre.jpg" alt="Sección Hombre" />
        <div class="overlay">
          <h1 class="vertical-text">HOMBRE</h1>
        </div>
      </div>
    </div>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        font-family: system-ui, -apple-system, sans-serif;
      }

      body {
        height: 100vh;
        overflow: hidden;
      }

      .categories-container {
        display: flex;
        width: 100vw;
        height: 100vh;
      }

      .category-card {
        position: relative;
        width: 50%;
        height: 100%;
        overflow: hidden;
      }

      .category-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.1);
      }

      .vertical-text {
        color: white;
        font-size: 3.5rem;
        font-weight: 800;
        letter-spacing: 4px;
        writing-mode: vertical-rl;
        text-transform: uppercase;
        user-select: none;
      }
    </style>
  </body>
</html>