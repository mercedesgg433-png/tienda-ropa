<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tienda de Ropa - Login</title>
  </head>
  <body>
    <div class="container">
      
      <div class="login-section">
        <div class="login-box">
          <div class="logo">
            <svg width="40" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M12 3L2 9l10 3 10-3-10-6zM2 15l10 3 10-3M2 21l10 3 10-3"/>
            </svg>
            <span>CLOTHING</span>
          </div>

          <h2>Welcome Back</h2>

          <form onsubmit="event.preventDefault();">
            <input type="text" placeholder="User" class="input-field" />
            <input type="password" placeholder="Password" class="input-field" />
            <button type="submit" class="btn-login">Log in</button>
          </form>

          <button class="btn-google">
            <svg width="18" height="18" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
            </svg>
            Login with Google
          </button>

          <a href="/categorias" class="link-next">Ir a Categorías (Página 2) &rarr;</a>
        </div>
      </div>

    
      <div class="image-section">
        <img src="/lookbook.jpg" alt="Ropa de temporada" />
      </div>
    </div>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        font-family: system-ui, -apple-system, sans-serif;
      }

      body {
        height: 100vh;
        overflow: hidden;
      }

      .container {
        display: flex;
        height: 100vh;
        width: 100vw;
      }

      .login-section {
        width: 40%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #ffffff;
        padding: 2rem;
      }

      .login-box {
        width: 100%;
        max-width: 320px;
        text-align: center;
      }

      .logo {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        margin-bottom: 2rem;
        font-size: 0.75rem;
        letter-spacing: 2px;
        font-weight: 600;
      }

      h2 {
        font-size: 1.5rem;
        margin-bottom: 2rem;
        font-weight: 600;
        color: #111;
      }

      form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .input-field {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 1px solid #e2e8f0;
        background-color: #f8fafc;
        border-radius: 4px;
        font-size: 0.875rem;
        outline: none;
      }

      .btn-login {
        width: 100%;
        padding: 0.75rem;
        background-color: #22c55e;
        color: white;
        border: none;
        border-radius: 4px;
        font-weight: 500;
        cursor: pointer;
        margin-top: 0.5rem;
      }

      .btn-google {
        width: 100%;
        padding: 0.75rem;
        background-color: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        cursor: pointer;
        margin-top: 1rem;
      }

      .image-section {
        width: 60%;
        height: 100%;
      }

      .image-section img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .link-next {
        display: inline-block;
        margin-top: 1.5rem;
        font-size: 0.85rem;
        color: #666;
        text-decoration: none;
      }
      .link-next:hover {
        text-decoration: underline;
      }
    </style>
  </body>
</html>